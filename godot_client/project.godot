; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Snowcrash Godot Client"
config/description="Thin WebSocket Godot 4 client for adventure-snowcrash (#118/#127/#132/#133/#134). StreetNet, year docks, onboarding, audio; Steam Deck Linux export path; talks to existing Python /ws."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

; Steam Deck / gamepad courier loop (#132) — see docs/steam-deck.md.
; Keyboard remains physical-key handled in main.gd; these actions feed joypad.
; Joy buttons: 0A 1B 2X 3Y 4L1 5R1 6Select 7Start 11–14 D-pad.
; Axes: 0/1 left stick, 2/3 right stick, 4/5 triggers.
move_forward={
"deadzone": 0.35,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":-1.0,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":11,"pressure":0.0,"pressed":true,"script":null)
]
}
move_back={
"deadzone": 0.35,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":1.0,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":12,"pressure":0.0,"pressed":true,"script":null)
]
}
